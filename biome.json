{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "parts/**",
      "rig/**",
      "scripts/**",
      "tests/**",
      "examples/**",
      "docs/*.mjs",
      "!tests/planted",
      "!examples/*/tent.d.ts",
      "!examples/*/walk/pictures",
      "!!**/.tent",
      "!!results",
      "!!.claude",
      "!parts/*/tests/*/*"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "expand": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noEmptyInterface": "off",
        "noExplicitAny": "error",
        "noShadowRestrictedNames": "off",
        "noThenProperty": "off"
      },
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  }
}
