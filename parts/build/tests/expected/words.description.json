{
  "app": {
    "name": "shop",
    "needsEngine": "1.0"
  },
  "flows": {
    "bigOrder": {
      "body": [
        {
          "const": "customer",
          "value": {
            "await": {
              "args": [
                "find customer",
                {
                  "arrow": [],
                  "do": [
                    {
                      "return": {
                        "plan": {
                          "db": "customers"
                        },
                        "then": [
                          {
                            "get": [
                              {
                                "name": [
                                  "event",
                                  "row",
                                  "customer"
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              ],
              "fn": "step"
            }
          }
        },
        {
          "if": {
            "not": {
              "name": [
                "customer"
              ]
            }
          },
          "then": [
            {
              "return": {
                "nothing": true
              }
            }
          ]
        },
        {
          "do": {
            "await": {
              "args": [
                "tell sales",
                {
                  "arrow": [],
                  "do": [
                    {
                      "return": {
                        "args": [
                          {
                            "object": [
                              [
                                "channel",
                                "#sales"
                              ],
                              [
                                "text",
                                {
                                  "text": [
                                    "Big order from ",
                                    {
                                      "name": [
                                        "customer",
                                        "name"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            ]
                          }
                        ],
                        "call": {
                          "call": "postMessage",
                          "service": "slack"
                        }
                      }
                    }
                  ]
                }
              ],
              "fn": "step"
            }
          }
        },
        {
          "do": {
            "await": {
              "args": [
                "3 days"
              ],
              "fn": "step.wait"
            }
          }
        },
        {
          "do": {
            "await": {
              "args": [
                "follow up",
                {
                  "arrow": [],
                  "do": [
                    {
                      "return": {
                        "args": [
                          {
                            "object": [
                              [
                                "to",
                                {
                                  "name": [
                                    "customer",
                                    "email"
                                  ]
                                }
                              ],
                              [
                                "subject",
                                "How was your order?"
                              ],
                              [
                                "text",
                                "Tell us how it went."
                              ]
                            ]
                          }
                        ],
                        "call": {
                          "builtin": "mail.send"
                        }
                      }
                    }
                  ]
                }
              ],
              "fn": "step"
            }
          }
        }
      ],
      "form": "plain",
      "on": [
        {
          "table": "orders",
          "when": "added",
          "where": {
            "above": 1000,
            "col": "total"
          }
        }
      ],
      "stepNames": [
        {
          "name": "find customer"
        },
        {
          "name": "tell sales"
        },
        {
          "name": "wait"
        },
        {
          "name": "follow up"
        }
      ],
      "together": {
        "max": 5
      }
    }
  },
  "format": "tent.description/1",
  "functions": {
    "markPaid": {
      "access": {
        "rule": "signedIn"
      },
      "form": "plain",
      "input": {
        "order": {
          "kind": "link",
          "table": "orders"
        }
      },
      "kind": "change",
      "touches": [
        "orders"
      ],
      "writes": [
        {
          "change": "orders",
          "id": {
            "input": "order"
          },
          "values": {
            "status": "paid"
          }
        }
      ]
    },
    "openOrders": {
      "about": "Open orders, newest first",
      "access": {
        "rule": "signedIn"
      },
      "form": "plain",
      "input": {
        "limit": {
          "default": 50,
          "kind": "number",
          "max": 200
        }
      },
      "kind": "query",
      "plan": {
        "from": "orders",
        "limit": {
          "input": "limit"
        },
        "sort": [
          {
            "by": "placedAt",
            "down": true
          }
        ],
        "where": {
          "col": "status",
          "is": "open"
        },
        "with": [
          "customer"
        ]
      },
      "reads": [
        "orders",
        "customers"
      ]
    },
    "refund": {
      "access": {
        "role": "staff",
        "rule": "role"
      },
      "body": [
        {
          "const": "order",
          "value": {
            "await": {
              "plan": {
                "db": "orders",
                "system": true
              },
              "then": [
                {
                  "get": [
                    {
                      "name": [
                        "input",
                        "order"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "not": {
              "name": [
                "order",
                "?chargeId"
              ]
            }
          },
          "then": [
            {
              "do": {
                "args": [
                  "not-charged",
                  "This order was never charged."
                ],
                "fn": "fail"
              }
            }
          ]
        },
        {
          "do": {
            "await": {
              "args": [
                {
                  "object": [
                    [
                      "charge",
                      {
                        "name": [
                          "order",
                          "chargeId"
                        ]
                      }
                    ]
                  ]
                }
              ],
              "call": {
                "call": "createRefund",
                "service": "stripe"
              }
            }
          }
        },
        {
          "do": {
            "await": {
              "args": [
                {
                  "object": [
                    [
                      "order",
                      {
                        "name": [
                          "order",
                          "id"
                        ]
                      }
                    ]
                  ]
                }
              ],
              "call": {
                "function": "reopen"
              }
            }
          }
        },
        {
          "return": {
            "object": [
              [
                "ok",
                true
              ]
            ]
          }
        }
      ],
      "danger": "ask",
      "form": "plain",
      "input": {
        "order": {
          "kind": "link",
          "table": "orders"
        },
        "reason": {
          "kind": "text",
          "max": 500
        }
      },
      "kind": "action",
      "output": {
        "kind": "object",
        "shape": {
          "ok": {
            "kind": "boolean"
          }
        }
      },
      "reads": [
        "orders"
      ],
      "system": "staff refund any order, not only their own",
      "touches": [
        "orders"
      ]
    },
    "reopen": {
      "access": {
        "role": "staff",
        "rule": "role"
      },
      "form": "plain",
      "input": {
        "order": {
          "kind": "link",
          "table": "orders"
        }
      },
      "kind": "change",
      "system": "staff reopen any order, not only their own",
      "touches": [
        "orders"
      ],
      "writes": [
        {
          "change": "orders",
          "id": {
            "input": "order"
          },
          "values": {
            "chargeId": null,
            "status": "open"
          }
        }
      ]
    }
  },
