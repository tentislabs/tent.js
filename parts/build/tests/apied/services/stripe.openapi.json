{
  "openapi": "3.1.0",
  "info": { "title": "Stripe", "version": "1" },
  "paths": {
    "/v1/refunds": {
      "post": {
        "operationId": "PostRefunds",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "type": "object", "required": ["charge"], "properties": { "charge": { "type": "string" } } }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } }
              }
            }
          }
        }
      }
    },
    "/v1/charges/{charge}": {
      "get": {
        "operationId": "GetChargesCharge",
        "parameters": [
          { "name": "charge", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "Stripe-Account", "in": "header", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "id": { "type": "string" }, "paid": { "type": "boolean" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
