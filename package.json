{
  "name": "tent.js-repository",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": "26.11.0" },
  "scripts": {
    "lists": "node scripts/lists.mjs",
    "format": "biome format --write",
    "lint": "biome format && biome lint --error-on-warnings --diagnostic-level=warn && node scripts/comments.mjs",
    "types": "tsc",
    "test": "node scripts/tests.mjs",
    "night": "node scripts/tests.mjs --night",
    "tent": "node parts/cli/shell.ts",
    "all": "npm run lists && npm run lint && npm run types && node scripts/search.mjs && npm test"
  },
  "dependencies": {
    "nodemailer": "10.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-refresh": "0.19.0",
    "vite": "8.3.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "knip": "6.41.0",
    "oxc-parser": "0.153.0",
    "playwright-core": "1.64.0",
    "roboto-fontface": "0.10.0",
    "typescript": "7.0.2"
  }
}
